# ---- LLM provider: offline | openai | anthropic | azure ----
# "offline" needs no key: deterministic, rule-based responses (great for demos & CI).
ATLAS_LLM_PROVIDER=offline

OPENAI_API_KEY=
ATLAS_OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ATLAS_ANTHROPIC_MODEL=claude-opus-5-5

AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21
ATLAS_AZURE_DEPLOYMENT=

# ---- Embeddings: lsa (offline, sklearn) | sentence-transformers | openai ----
ATLAS_EMBEDDING_PROVIDER=lsa
ATLAS_ST_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ---- Storage ----
# SQLite by default; docker-compose switches this to Postgres.
ATLAS_DATABASE_URL=sqlite:///data/atlas.db
ATLAS_DATA_DIR=data
ATLAS_ARTIFACTS_DIR=artifacts

# ---- MLOps ----
MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# ---- API ----
ATLAS_API_KEY=change-me
